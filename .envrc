# Loads the Google OAuth Desktop client from 1Password into the environment.
# Contains no secrets - only op:// references. Requires the 1Password CLI
# signed in (app integration) and `direnv allow` once.
#
# Override the vault/item with SENTRYMAIL_OP_VAULT / SENTRYMAIL_OP_ITEM in
# ~/.zshrc (or a .envrc.local) if yours differ from the defaults.
OP_VAULT="${SENTRYMAIL_OP_VAULT:-Private}"
OP_ITEM="${SENTRYMAIL_OP_ITEM:-SentryMail Google OAuth}"

if command -v op >/dev/null 2>&1; then
  export GOOGLE_OAUTH_CLIENT_ID="$(op read "op://$OP_VAULT/$OP_ITEM/client_id" 2>/dev/null || true)"
  export GOOGLE_OAUTH_CLIENT_SECRET="$(op read "op://$OP_VAULT/$OP_ITEM/client_secret" 2>/dev/null || true)"
  if [[ -z "$GOOGLE_OAUTH_CLIENT_ID" ]]; then
    echo "direnv: 1Password item 'op://$OP_VAULT/$OP_ITEM' not readable; app will fall back to google_oauth_client.json" >&2
  fi
else
  echo "direnv: 'op' not installed; app will fall back to google_oauth_client.json" >&2
fi

# Optional per-machine overrides (gitignored).
source_env_if_exists .envrc.local
